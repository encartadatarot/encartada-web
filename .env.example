# Copia este archivo a .env.local para desarrollo, y añade las mismas variables en Vercel
# (Project → Settings → Environment Variables).

# URL pública del sitio (sin barra final). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys  (usa las claves "test" mientras pruebas)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook: https://dashboard.stripe.com/webhooks → endpoint https://tu-dominio.com/api/stripe/webhook
# evento: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxx

# (Opcional) Emails de confirmación con Resend — https://resend.com
RESEND_API_KEY=
EMAIL_REMITENTE="en_cartada <reservas@tu-dominio.com>"
EMAIL_AVISOS=encartada.tarot@gmail.com
